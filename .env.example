# ============================================================
# 企业级 RAG 平台 —— 环境变量模板
# 用法：cp .env.example .env
# 优先级：进程环境变量 > .env.<RAG_ENV> > .env > 代码默认值
# 本文件会被提交进 git，禁止写入任何真实密钥。
# ============================================================

# ---- 运行环境：local | dev | staging | prod ----
RAG_ENV=local

# ---- 应用 ----
RAG_APP_NAME=enterprise-rag-platform
RAG_DEBUG=true
RAG_LOG_LEVEL=DEBUG
# 开发登录端点。开启后可用 dev:<subject> 直接登录，生产禁止
# （生产开它会导致启动失败）
RAG_DEV_AUTH_ENABLED=true
# 留空则按环境推导：local/dev 用 console，staging/prod 用 json
# RAG_LOG_FORMAT=json

# ---- PostgreSQL ----
# 本机模式：连系统自带 PG 实例（127.0.0.1:5432），库名 rag
RAG_DATABASE__HOST=127.0.0.1
RAG_DATABASE__PORT=5432
# 运行时角色：必须是**非超级用户**，否则 RLS 完全失效
# （superuser 与 BYPASSRLS 角色无条件绕过所有行级安全策略）
RAG_DATABASE__USER=rag_app
RAG_DATABASE__PASSWORD=rag_local_dev_only
RAG_DATABASE__NAME=rag
# 迁移专用高权限角色（需要 CREATE/ALTER/POLICY）。不设则复用上面的 user
RAG_DATABASE__MIGRATION_USER=puraz
RAG_DATABASE__ADMIN_USER=rag_admin
RAG_DATABASE__ADMIN_PASSWORD=rag_local_dev_only
RAG_DATABASE__MIGRATION_PASSWORD=rag_local_dev_only
RAG_DATABASE__POOL_SIZE=10
RAG_DATABASE__MAX_OVERFLOW=10
RAG_DATABASE__POOL_TIMEOUT_S=5
RAG_DATABASE__STATEMENT_TIMEOUT_MS=15000
RAG_DATABASE__LOCK_TIMEOUT_MS=5000

# ---- Redis（本机跑的是 Valkey 9.1，协议兼容）----
RAG_REDIS__HOST=127.0.0.1
RAG_REDIS__PORT=6379
RAG_REDIS__DB=0
RAG_REDIS__PASSWORD=rag_local_dev_only
RAG_REDIS__SOCKET_TIMEOUT_S=3
RAG_REDIS__MAX_CONNECTIONS=50

# ---- LLM 供应商 ----
RAG_LLM__PROVIDER=deepseek
# 密钥只走环境变量，绝不进库、不进日志。
# 实际可用模型（2026-11 官方文档核实）：
#   deepseek-flash   V4.1-Flash  1M 上下文  输入 $0.15/$0.30(谷/峰) 输出 $0.6/$1.2
#   deepseek-v4-pro  V4-Pro      1M 上下文  输入 $0.66/$1.32          输出 $1.98/$3.96
# 注意：deepseek-chat / deepseek-reasoner 已下线，会自动路由到 flash
RAG_LLM__API_KEY=
RAG_LLM__BASE_URL=https://api.deepseek.com/v1
RAG_LLM__CHAT_MODEL=deepseek-v4-pro
RAG_LLM__CHEAP_MODEL=deepseek-flash
# 思考深度 low/high/max。实测两模型默认开启思考且无法完全关闭，
# 思考 token 按输出价计费并会吃掉 max_tokens，故默认 low
RAG_LLM__REASONING_EFFORT=low

# ---- Embedding（本地 bge-m3，无需 API key）----
# 维度必须与 chunks.embedding 的 vector(1024) 一致
RAG_EMBEDDING__PROVIDER=local_bge
RAG_EMBEDDING__MODEL_NAME=BAAI/bge-m3
RAG_EMBEDDING__DIMENSION=1024
# cpu / cuda / mps。本地模型占约 2.2GB 内存，每个 worker 进程一份
RAG_EMBEDDING__DEVICE=cuda
RAG_EMBEDDING__BATCH_SIZE=32
# bge-m3 不需要查询指令前缀；换 bge-large-zh-v1.5 时才需要配
# RAG_EMBEDDING__QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# HuggingFace 镜像。国内直连 huggingface.co 会超时，必须配镜像
RAG_EMBEDDING__HF_ENDPOINT=https://hf-mirror.com

# ---- 对象存储 ----
# local: 本地磁盘（开发/测试） | s3: S3 协议（AWS/MinIO/OSS/COS）
RAG_STORAGE__BACKEND=local
RAG_STORAGE__LOCAL_ROOT=.data/storage
# 分片大小。S3 要求 ≥5MB（否则 complete 时报 EntityTooSmall）
RAG_STORAGE__PART_SIZE=8388608
# 超过此大小才走分片上传
RAG_STORAGE__MULTIPART_THRESHOLD=104857600
RAG_STORAGE__MAX_FILE_SIZE=2147483648

# S3 兼容后端配置（backend=s3 时生效）
# 换厂商只改 endpoint_url：AWS/MinIO/OSS/COS/七牛都兼容 S3 协议
# RAG_STORAGE__S3_BUCKET=rag-documents
# RAG_STORAGE__S3_ENDPOINT_URL=http://127.0.0.1:9000
# RAG_STORAGE__S3_ACCESS_KEY=
# RAG_STORAGE__S3_SECRET_KEY=
# MinIO 必须用 path-style；AWS 用 virtual
# RAG_STORAGE__S3_ADDRESSING_STYLE=path

# ---- 检索链路 ----
# 双路召回：向量 + 关键词（jieba 预分词 + PG 内置 FTS + RRF 融合）
RAG_RETRIEVAL__USE_KEYWORD=true
# 多轮对话用 LLM 做独立化改写（指代消解）
RAG_RETRIEVAL__USE_REWRITE=true
# 重排需要 RAG_RERANKER__PROVIDER 不是 none；先用评估验证增益再开
RAG_RETRIEVAL__USE_RERANK=false
# 生成后自省（拦幻觉）：每次问答多一次 LLM 调用
RAG_RETRIEVAL__USE_SELF_CHECK=false
# flag: 保留答案并标 degraded | refuse: 替换为拒答
RAG_RETRIEVAL__SELF_CHECK_ACTION=flag
RAG_RETRIEVAL__VECTOR_LIMIT=20
RAG_RETRIEVAL__KEYWORD_LIMIT=20
RAG_RETRIEVAL__FINAL_LIMIT=5
RAG_RETRIEVAL__RERANK_TOP_N=10
RAG_RETRIEVAL__RRF_K=60
RAG_RETRIEVAL__MAX_KEYWORDS=8
# 距离上限：默认不设。A11 实测距离区间重叠，阈值不能用于拒答
# RAG_RETRIEVAL__MAX_DISTANCE=0.6

# ---- Reranker（cross-encoder）----
# none: 直通 | local_bge: sentence-transformers CrossEncoder
RAG_RERANKER__PROVIDER=none
RAG_RERANKER__MODEL_NAME=BAAI/bge-reranker-base
RAG_RERANKER__DEVICE=cpu
RAG_RERANKER__BATCH_SIZE=8
RAG_RERANKER__MAX_LENGTH=512
RAG_RERANKER__MAX_PAIRS=100
RAG_RERANKER__HF_ENDPOINT=https://hf-mirror.com
