            "INTERNAL.NOT_IMPLEMENTED"
          ],
          "title": "ErrorCode",
          "type": "string"
        },
        "FieldError": {
          "description": "字段级校验错误。供前端把错误标到具体输入框上。",
          "properties": {
            "location": {
              "description": "错误字段位置路径",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "title": "Location",
              "type": "array"
            },
            "message": {
              "description": "给用户看的中文提示",
              "title": "Message",
              "type": "string"
            },
            "type": {
              "description": "校验器错误类型标识",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "message",
            "type"
          ],
          "title": "FieldError",
          "type": "object"
        }
      },
      "description": "统一错误响应体。所有非 2xx 响应都必须是这个形状。",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode",
          "description": "业务错误码，前端按此分支处理"
        },
        "message": {
          "description": "面向用户的中文错误信息",
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "description": "请求追踪 ID，报障时提供此值",
          "title": "Request Id",
          "type": "string"
        },
        "fields": {
          "description": "字段级错误明细",
          "items": {
            "$ref": "#/$defs/FieldError"
          },
          "title": "Fields",
          "type": "array"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "可公开的结构化补充信息",
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "FieldError": {
      "description": "字段级校验错误。供前端把错误标到具体输入框上。",
      "properties": {
        "location": {
          "description": "错误字段位置路径",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Location",
          "type": "array"
        },
        "message": {
          "description": "给用户看的中文提示",
          "title": "Message",
          "type": "string"
        },
        "type": {
          "description": "校验器错误类型标识",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
