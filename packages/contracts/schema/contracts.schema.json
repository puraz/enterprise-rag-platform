{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "enums": {
    "ErrorCode": {
      "title": "ErrorCode",
      "type": "string",
      "enum": [
        "COMMON.VALIDATION_FAILED",
        "COMMON.BAD_REQUEST",
        "COMMON.NOT_FOUND",
        "COMMON.METHOD_NOT_ALLOWED",
        "COMMON.PAYLOAD_TOO_LARGE",
        "COMMON.UNSUPPORTED_MEDIA_TYPE",
        "COMMON.RATE_LIMITED",
        "COMMON.IDEMPOTENCY_CONFLICT",
        "COMMON.CONFLICT",
        "COMMON.PRECONDITION_FAILED",
        "AUTH.UNAUTHENTICATED",
        "AUTH.TOKEN_EXPIRED",
        "AUTH.TOKEN_INVALID",
        "AUTH.TOKEN_REVOKED",
        "AUTH.REFRESH_REUSED",
        "AUTH.INVALID_CREDENTIALS",
        "AUTH.ACCOUNT_DISABLED",
        "AUTH.IDP_UNAVAILABLE",
        "AUTHZ.FORBIDDEN",
        "AUTHZ.TENANT_MISMATCH",
        "AUTHZ.INSUFFICIENT_ROLE",
        "AUTHZ.DOCUMENT_ACCESS_DENIED",
        "AUTHZ.CLASSIFICATION_DENIED",
        "DOC.NOT_FOUND",
        "DOC.DUPLICATE",
        "DOC.STATUS_CONFLICT",
        "DOC.UNSUPPORTED_FORMAT",
        "DOC.PARSE_FAILED",
        "DOC.VERSION_NOT_FOUND",
        "CHUNK.NOT_FOUND",
        "KB.NOT_FOUND",
        "KB.NAME_CONFLICT",
        "CONV.NOT_FOUND",
        "CONV.BUSY",
        "UPLOAD.SESSION_NOT_FOUND",
        "UPLOAD.SESSION_EXPIRED",
        "UPLOAD.PART_MISMATCH",
        "UPLOAD.INCOMPLETE",
        "UPLOAD.HASH_MISMATCH",
        "UPLOAD.EMPTY_FILE",
        "UPLOAD.FILE_TOO_LARGE",
        "UPLOAD.MIME_MISMATCH",
        "TASK.NOT_FOUND",
        "TASK.NOT_CANCELLABLE",
        "INDEX.REBUILD_IN_PROGRESS",
        "INDEX.VERSION_NOT_FOUND",
        "QUOTA.EXCEEDED",
        "QUOTA.BUDGET_EXHAUSTED",
        "PROVIDER.UNAVAILABLE",
        "PROVIDER.TIMEOUT",
        "PROVIDER.RATE_LIMITED",
        "PROVIDER.AUTH_FAILED",
        "PROVIDER.CONTENT_FILTERED",
        "PROVIDER.INVALID_RESPONSE",
        "INTERNAL.UNEXPECTED",
        "INTERNAL.CONFIG_ERROR",
        "INTERNAL.DEPENDENCY_UNAVAILABLE",
        "INTERNAL.NOT_IMPLEMENTED"
      ],
      "description": "全平台错误码。\n\n    字符串值形如 `<域>.<含义>`，前缀即分类，便于前端一眼判断处理策略。"
    },
    "ErrorCategory": {
      "title": "ErrorCategory",
      "type": "string",
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "not_found",
        "conflict",
        "rate_limit",
        "quota",
        "dependency",
        "internal"
      ],
      "description": "错误大类。决定\"该谁负责\"和\"前端该怎么处理\"。\n\n    与 HTTP 状态码是两套体系：状态码给网关/监控看，category 给人和\n    前端策略看。两者由异常类分别声明，不互相推导。"
    },
    "Severity": {
      "title": "Severity",
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "description": "日志与告警级别。把\"要不要半夜叫醒人\"编码进错误定义。"
    },
    "TenantStatus": {
      "title": "TenantStatus",
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "deleted"
      ],
      "description": "租户状态。"
    },
    "UserStatus": {
      "title": "UserStatus",
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "pending"
      ],
      "description": "用户全局状态。\n\n    注意与 `MembershipStatus` 的区别：这个字段管\"这个人还能不能用\"，\n    `MembershipStatus` 管\"这个人在某个租户里是否生效\"。"
    },
    "TenantRole": {
      "title": "TenantRole",
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "knowledge_admin",
        "member",
        "viewer"
      ],
      "description": "租户内角色，权限从高到低。\n\n    **这是租户内角色，不是平台角色**——平台侧看 `PlatformRole`，两者正交。"
    },
    "PlatformRole": {
      "title": "PlatformRole",
      "type": "string",
      "enum": [
        "none",
        "super_admin",
        "platform_operator",
        "auditor"
      ],
      "description": "平台级角色（管理端）。\n\n    与 `TenantRole` 正交：平台超管未必是任何租户的成员。\n    两者分开是因为「跨租户治理」和「租户内协作」是两种权力来源，\n    混成一个字段会导致越权判断写成一团 if-else。"
    },
    "MembershipStatus": {
      "title": "MembershipStatus",
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "removed"
      ],
      "description": "成员关系状态。\n\n    与 `UserStatus` 分开：用户可以是 active，但在这个租户里被移除。\n    把两者合成一个字段会导致「禁用某人」和「从租户移除某人」无法区分。"
    },
    "KnowledgeBaseStatus": {
      "title": "KnowledgeBaseStatus",
      "type": "string",
      "enum": [
        "active",
        "archived",
        "deleted"
      ],
      "description": "知识库状态。"
    },
    "KnowledgeBaseVisibility": {
      "title": "KnowledgeBaseVisibility",
      "type": "string",
      "enum": [
        "private",
        "tenant",
        "department"
      ],
      "description": "知识库可见范围。\n\n    这是**库级**的粗粒度控制；文档级的 ACL 与密级是更细的一层（A7 实现）。\n    两层并存的原因：绝大多数场景只需库级控制（整个部门库），\n    逐文档配 ACL 成本太高；但敏感文档确实需要单独收紧。"
    },
    "ConfidentialityLevel": {
      "title": "ConfidentialityLevel",
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "secret"
      ],
      "description": "密级。数值越大越敏感。\n\n    密级与 ACL 是**正交**的两道门：\n    - ACL 回答\"你能不能看这个库/文档\"；\n    - 密级回答\"你这个人的密级够不够\"。\n    缺任何一道都会出事：只有 ACL 时，\"有权限的人\"可能是实习生；\n    只有密级时，\"够级的人\"可能不在这个部门。"
    },
    "DocumentStatus": {
      "title": "DocumentStatus",
      "type": "string",
      "enum": [
        "pending",
        "parsing",
        "chunking",
        "embedding",
        "indexing",
        "ready",
        "failed"
      ],
      "description": "文档处理状态机。\n\n    完整流转：\n\n        PENDING ──▶ PARSING ──▶ CHUNKING ──▶ EMBEDDING ──▶ INDEXING ──▶ READY\n           │           │           │            │            │\n           └───────────┴───────────┴────────────┴────────────┴──▶ FAILED\n                                                                  │\n                                                              (重试) ──▶ PENDING\n\n    约束（A3-4 的任务表会用同样的状态集）：\n    - 只有 READY 的文档能参与检索；\n    - FAILED 的文档保留原始 blob，允许重试而不必重新上传；\n    - 状态流转必须走乐观锁（`version`），否则并发重试会互相覆盖。"
    },
    "DocumentVersionStatus": {
      "title": "DocumentVersionStatus",
      "type": "string",
      "enum": [
        "processing",
        "ready",
        "failed",
        "superseded"
      ],
      "description": "文档版本状态。\n\n    与 `DocumentStatus` 分开：文档整体状态取\"当前版本\"的状态，\n    但历史版本有独立生命周期（可能已归档、已被新版本取代）。"
    },
    "DocumentFormat": {
      "title": "DocumentFormat",
      "type": "string",
      "enum": [
        "pdf",
        "docx",
        "pptx",
        "xlsx",
        "csv",
        "markdown",
        "html",
        "text",
        "image"
      ],
      "description": "文档格式。决定用哪个 parser 实现。\n\n    新增格式时必须同步：\n    1. `rag_api.parsers` 下的解析器实现；\n    2. 前端上传组件的 `accept` 白名单；\n    3. 本文档的注释（说明该格式的已知坑）。"
    },
    "SourceType": {
      "title": "SourceType",
      "type": "string",
      "enum": [
        "upload",
        "url",
        "connector",
        "api"
      ],
      "description": "文档来源类型。决定解析与去重策略的差异。"
    },
    "BlobStatus": {
      "title": "BlobStatus",
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "missing",
        "deleted"
      ],
      "description": "物理文件状态。\n\n    单独设状态的原因：上传可能中断、校验可能失败、对象存储可能丢文件。\n    文档版本引用一个 blob 时，必须确认它真的可用。"
    },
    "ChunkType": {
      "title": "ChunkType",
      "type": "string",
      "enum": [
        "text",
        "title",
        "table",
        "code",
        "formula",
        "image_caption",
        "list"
      ],
      "description": "chunk 的内容类型。\n\n    整块不切的类型（TABLE / CODE / FORMULA）在切分时会被保护，\n    不参与递归合并 —— 表格被切断会让行列错位，代码被切断会失去语义。"
    },
    "ChunkingStrategy": {
      "title": "ChunkingStrategy",
      "type": "string",
      "enum": [
        "recursive",
        "structured",
        "semantic",
        "sentence_window",
        "parent_child",
        "fixed"
      ],
      "description": "切分策略标识。\n\n    值必须与 `rag_api.chunkers` 注册表里的名字一致。\n    新增策略时要同时更新这里与注册表——不一致会导致 worker 找不到实现，\n    报错信息是\"未知策略\"，但实际是名字拼写不同。"
    },
    "IndexType": {
      "title": "IndexType",
      "type": "string",
      "enum": [
        "hnsw",
        "ivfflat",
        "none"
      ],
      "description": "向量索引类型。\n\n    HNSW vs IVFFlat 的取舍：\n    - HNSW：查询快、召回高、无需训练，但构建慢、内存占用大；\n    - IVFFlat：构建快、内存小，但需要数据量足够才能训练好，\n      且召回受 probes 影响明显。\n    本项目默认 HNSW：知识库规模通常是十万到百万级 chunk，\n    HNSW 的查询延迟优势更重要。"
    },
    "IndexVersionStatus": {
      "title": "IndexVersionStatus",
      "type": "string",
      "enum": [
        "building",
        "ready",
        "active",
        "retired",
        "failed"
      ],
      "description": "索引版本状态（A10 零停机重建用）。\n\n    双版本 + alias 切换的完整生命周期：\n\n        BUILDING → READY → ACTIVE → RETIRED\n                     │                 ▲\n                     └──(切换前可回滚)──┘\n\n    重建期间双写两个版本，切换瞬间只改 alias 指向。"
    },
    "DistanceMetric": {
      "title": "DistanceMetric",
      "type": "string",
      "enum": [
        "cosine",
        "l2",
        "inner_product"
      ],
      "description": "向量距离度量。\n\n    **必须与 embedding 模型的训练目标一致**：\n    - bge 系列、多数字段中文模型：用余弦（cosine）；\n    - OpenAI text-embedding-3：用余弦；\n    - 少数模型（如某些 e5 变体）训练时用内积。\n    用错度量不会报错，只会让召回悄悄变差——这是最难发现的检索问题之一。"
    },
    "RetrievalMode": {
      "title": "RetrievalMode",
      "type": "string",
      "enum": [
        "vector",
        "keyword",
        "hybrid"
      ],
      "description": "检索模式（A11 用）。"
    },
    "UploadSessionStatus": {
      "title": "UploadSessionStatus",
      "type": "string",
      "enum": [
        "initiated",
        "uploading",
        "completing",
        "completed",
        "failed",
        "expired",
        "aborted"
      ],
      "description": "分片上传会话状态机。\n\n        INITIATED ──▶ UPLOADING ──▶ COMPLETING ──▶ COMPLETED\n            │             │              │\n            │             │              └──▶ FAILED（合并/校验失败）\n            │             └──▶ EXPIRED（超时未完成）\n            └──▶ ABORTED（用户取消）\n\n    关键约束：\n    - COMPLETED 之后不能再收分片（幂等返回成功）；\n    - EXPIRED 与 ABORTED 的分片由清理任务回收；\n    - COMPLETING 是\"合并中\"的中间态，防止两个请求同时 complete。"
    },
    "TaskType": {
      "title": "TaskType",
      "type": "string",
      "enum": [
        "parse_document",
        "chunk_document",
        "embed_document",
        "index_document",
        "rebuild_index",
        "cleanup_upload_sessions",
        "cleanup_orphan_blobs",
        "dispatch_outbox"
      ],
      "description": "异步任务类型。\n\n    值必须与 worker 侧的任务注册表一致——不一致时报错是\n    \"未知任务类型\"，但实际是名字拼写不同，很难定位。"
    },
    "TaskStatus": {
      "title": "TaskStatus",
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "dead",
        "cancelled"
      ],
      "description": "任务执行状态。\n\n    与 `DocumentStatus` 分开：任务表记录\"某次执行的进展\"，\n    文档表记录\"业务上的最终状态\"。一次文档处理可能产生多次任务执行\n    （每次重试一条），管理端需要看到历史。"
    },
    "OutboxStatus": {
      "title": "OutboxStatus",
      "type": "string",
      "enum": [
        "pending",
        "dispatched",
        "failed"
      ],
      "description": "outbox 消息状态。\n\n    至少一次送达：只要消息没有标记为 dispatched，就会一直被轮询重发。\n    消费者必须幂等——这是\"至少一次\"语义的必然要求。"
    },
    "AuditAction": {
      "title": "AuditAction",
      "type": "string",
      "enum": [
        "auth.login",
        "auth.logout",
        "auth.token_refresh",
        "auth.login_failed",
        "knowledge_base.create",
        "knowledge_base.update",
        "knowledge_base.delete",
        "document.upload",
        "document.read",
        "document.download",
        "document.delete",
        "document.version_rollback",
        "retrieval.query",
        "chat.completion",
        "security.access_denied",
        "security.tenant_mismatch",
        "security.rate_limited",
        "security.token_reused",
        "security.prompt_injection",
        "admin.index_rebuild",
        "admin.permission_change",
        "admin.provider_change",
        "admin.config_change"
      ],
      "description": "审计动作类型。\n\n    **命名规则**：`<资源>.<动词>`，全小写下划线连接资源名。\n    值是对外契约的一部分（管理端按此筛选），一旦发布不能改。"
    },
    "AuditOutcome": {
      "title": "AuditOutcome",
      "type": "string",
      "enum": [
        "success",
        "denied",
        "failed"
      ],
      "description": "操作结果。"
    },
    "AuditTargetType": {
      "title": "AuditTargetType",
      "type": "string",
      "enum": [
        "tenant",
        "user",
        "knowledge_base",
        "document",
        "document_version",
        "conversation",
        "provider",
        "config"
      ],
      "description": "被操作对象的类型。用于按对象查审计（\"这个文档被谁看过\"）。"
    },
    "ModelTaskType": {
      "title": "ModelTaskType",
      "type": "string",
      "enum": [
        "chat",
        "query_rewrite",
        "multi_query",
        "hyde",
        "context_compress",
        "embedding",
        "rerank",
        "evaluation"
      ],
      "description": "模型调用的任务类型。\n\n    成本按任务类型拆分是必需的：`docs/PROMPT.md` 要求\"按租户-功能-模型\n    三维成本拆解\"。没有这个字段，就无法回答\"钱主要花在检索改写还是回答生成上\"。"
    },
    "ModelCallStatus": {
      "title": "ModelCallStatus",
      "type": "string",
      "enum": [
        "success",
        "failed",
        "timeout",
        "rate_limited",
        "content_filtered"
      ],
      "description": "模型调用结果。"
    }
  },
  "models": {
    "ErrorResponse": {
      "$defs": {
        "ErrorCode": {
          "description": "全平台错误码。\n\n字符串值形如 `<域>.<含义>`，前缀即分类，便于前端一眼判断处理策略。",
          "enum": [
            "COMMON.VALIDATION_FAILED",
            "COMMON.BAD_REQUEST",
            "COMMON.NOT_FOUND",
