    "ErrorCategory": {
      "title": "ErrorCategory",
      "type": "string",
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "not_found",
        "conflict",
        "rate_limit",
        "quota",
        "dependency",
        "internal"
      ],
      "description": "错误大类。决定\"该谁负责\"和\"前端该怎么处理\"。\n\n    与 HTTP 状态码是两套体系：状态码给网关/监控看，category 给人和\n    前端策略看。两者由异常类分别声明，不互相推导。"
    },
    "Severity": {
      "title": "Severity",
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "description": "日志与告警级别。把\"要不要半夜叫醒人\"编码进错误定义。"
    }
